# Pick the value that matches how you're running the app:
#   Web preview (npx expo start --web)      -> http://localhost:4000/api/v1/app
#   iOS simulator                            -> http://localhost:4000/api/v1/app
#   Android emulator                         -> http://10.0.2.2:4000/api/v1/app
#   Physical device on the same Wi-Fi        -> http://<your-computer's-LAN-IP>:4000/api/v1/app
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1/app
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
